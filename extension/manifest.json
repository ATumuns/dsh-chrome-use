{
  "manifest_version": 3,
  "name": "DSH-Chrome-Use",
  "version": "1.0.1",
  "description": "Lets DeepSeek Harness drive this Chromium browser over CDP: tab control, accessibility snapshots, clicking, typing, screenshots, network and console capture.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "cookies",
    "downloads",
    "history",
    "webNavigation",
    "alarms",
    "notifications",
    "contentSettings",
    "geolocation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "DSH-Chrome-Use",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
